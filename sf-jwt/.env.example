# Caminho da chave privada gerada por gen_cert.py (nome real do arquivo, nao mude)
SF_PRIVATE_KEY_PATH=salesforce.key

# Consumer Key da Connected App
SF_CONSUMER_KEY=

# Usuario de integracao (precisa estar Pre-Authorized na Connected App)
SF_USERNAME=

# https://login.salesforce.com (producao/dev-edition) ou https://test.salesforce.com (sandbox)
SF_LOGIN_URL=https://login.salesforce.com
